# Slack Workflow Builder Webhook or Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=

# Monitored Production Domains (Format: "Provider1=domain1.com,domain2.com|Provider2=domain3.com" or JSON array)
MONITORED_DOMAINS="WP Engine=example1.com,example2.com|Kinsta=example3.com|Pantheon=example4.com|Ploi.io=example5.com"

# Optional: Google Gemini API key for AI-refined headlines & prioritization
# (If omitted, the built-in deterministic scoring engine is used automatically)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Schedule & Timezone Configuration (defaults to Vancouver business hours: 8am-6pm)
TIMEZONE=America/Vancouver
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=18
LOOKBACK_HOURS=72
URGENT_LOOKBACK_HOURS=72
RELEASE_LOOKBACK_HOURS=240
MAX_ITEMS_PER_DIGEST=12
